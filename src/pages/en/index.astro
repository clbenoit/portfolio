---
import LandingLayout from '../../layouts/LandingLayout.astro';
---

<LandingLayout lang="en">
  <div class="landing-root">
    <div class="landing-hero">
      <h1 class="landing-heading">
        Hi !<br />
        I'm Clément BENOIT
      </h1>
      <p class="landing-bio">
        <b>I translate business needs into tools that accelerate workflows.</b>
        <br /><br />
        Specialized in complex data, automation, and interfaces, between technical and operational teams, <b>I solve the bottlenecks that slow organizations down</b> : slow processes, scattered data, tools disconnected from the field. By combining data, automation, and regulatory rigor, I turn these frustrations into <b>smooth, auditable, production-ready workflows</b>.
        <br /><br />
        Today, I do this mostly in clinical bioinformatics — where I industrialize AI inside validated processes (<b>ISO 15189, ISO 27001</b>), where every pipeline must be traceable, reproducible, and always serving human decision.
      </p>

      <p class="landing-bio">
        I'm always open to other kinds of projects — <b>regulated environments are not a problem</b> ! Let's talk about your project.
      </p>

      <a href="/portfolio/en/contact/" class="landing-cta">
        Let's talk about your project
      </a>

      <p class="landing-bio"><br />
        <b>Outside of work:</b> skateboarding, tending my plants, exploring the Alps around Grenoble and leading a developer collective on the side.
      </p>

      <div class="landing-buttons">
        <a href="/portfolio/en/projects/" class="landing-button landing-button-accent">
          See my projects
        </a>
        <a href="https://github.com/clbenoit" class="landing-button">
          GitHub
        </a>
        <a href="https://linkedin.com/in/clement-benoit" class="landing-button">
          LinkedIn
        </a>
      </div>
    </div>
  </div>
</LandingLayout>

<style>
  .landing-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 64px);
    text-align: center;
    padding: 80px 24px;
  }

  .landing-heading {
    font-size: 32px;
    font-weight: 700;
    color: var(--color-heading);
    margin: 0 0 16px;
    line-height: 1.4;
  }

  .landing-bio {
    font-size: 18px;
    color: var(--color-text2);
    max-width: 720px;
    margin: 0 auto 32px;
    line-height: 1.7;
  }

  .landing-bio b {
    color: var(--color-text);
  }

  .landing-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-bottom: 24px;
  }

  .landing-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    background: var(--color-background2);
    transition: all 0.15s ease;
  }

  .landing-button:hover {
    background: var(--color-background3);
    border-color: var(--color-border2);
  }

  .landing-button-accent {
    background: var(--color-backgroundAccent);
    color: var(--color-backgroundAccentText);
    border-color: var(--color-backgroundAccent);
  }

  .landing-button-accent:hover {
    background: var(--color-backgroundAccentHover);
    border-color: var(--color-backgroundAccentHover);
  }

  .landing-cta {
    display: inline-block;
    padding: 16px 36px;
    font-size: 18px;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;
    color: var(--color-backgroundAccentText);
    background: var(--color-backgroundAccent);
    border: 2px solid var(--color-backgroundAccent);
    transition: all 0.15s ease;
  }

  .landing-cta:hover {
    background: var(--color-backgroundAccentHover);
    border-color: var(--color-backgroundAccentHover);
    transform: translateY(-1px);
  }

  @media (max-width: 600px) {
    .landing-buttons {
      flex-direction: column;
      width: 100%;
    }

    .landing-button {
      width: 100%;
      text-align: center;
    }
  }
</style>