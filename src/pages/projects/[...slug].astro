---
import { getCollection, render } from 'astro:content';
import DefaultLayout from '../../layouts/DefaultLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return Promise.all(projects.map(async (project) => {
    const { Content } = await render(project);
    return {
      params: { slug: project.id },
      props: { project, Content },
    };
  }));
}

const { project, Content } = Astro.props;
---

<DefaultLayout title={project.data.title}>
  <div class="project-content">
    <Content />
  </div>
</DefaultLayout>

<style>
  .project-content :global(h1) {
    color: var(--color-heading);
    margin-top: 0;
  }

  .project-content :global(h2),
  .project-content :global(h3) {
    color: var(--color-heading);
    margin-top: 2em;
    margin-bottom: 0.5em;
  }

  .project-content :global(h3 i) {
    color: var(--color-text2);
    font-weight: 400;
  }

  .project-content :global(p) {
    margin: 1em 0;
  }

  .project-content :global(a) {
    color: var(--color-textAccent);
    text-decoration: none;
  }

  .project-content :global(a:hover) {
    color: var(--color-textAccentHover);
    text-decoration: underline;
  }

  .project-content :global(img),
  .project-content :global(video) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5em 0;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    padding-left: 24px;
  }

  .project-content :global(li) {
    margin: 0.5em 0;
  }

  .project-content :global(code) {
    background: var(--color-background3);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .project-content :global(pre) {
    background: var(--color-background3);
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.5;
  }

  .project-content :global(pre code) {
    background: none;
    padding: 0;
  }
</style>