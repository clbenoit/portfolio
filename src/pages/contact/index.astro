---
import MinimalLayout from '../../layouts/MinimalLayout.astro';
import ProjectRequestForm from '../../components/ProjectRequestForm.jsx';
---

<MinimalLayout title="Contact">
  <div class="contact-page">
    <h1 class="contact-heading">Let's work together</h1>
    <p class="contact-subtitle">
      Tell me about your project and I'll get back to you within 48 hours.
    </p>
    <ProjectRequestForm client:load />

    <div class="contact-email-section">
      <hr class="contact-divider" />
      <p class="contact-email-note">
        Prefer using email instead? Feel free to write me directly —
        especially for quick questions, follow-ups, or topics that aren't
        a project request.
      </p>
      <a href="mailto:benoitclement.data@gmail.com" class="contact-email-link">
        benoitclement.data@gmail.com
      </a>
    </div>
  </div>
</MinimalLayout>

<style>
  .contact-page {
    max-width: 680px;
    margin: 0 auto;
    padding: 64px 24px 80px;
  }

  .contact-heading {
    font-size: 28px;
    font-weight: 700;
    color: var(--color-heading);
    margin: 0 0 8px;
    text-align: center;
  }

  .contact-subtitle {
    font-size: 16px;
    color: var(--color-text3);
    text-align: center;
    margin: 0 0 40px;
    line-height: 1.6;
  }

  .contact-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 48px 0 24px;
  }

  .contact-email-section {
    text-align: center;
  }

  .contact-email-note {
    font-size: 14px;
    color: var(--color-text3);
    margin: 0 0 12px;
    line-height: 1.6;
  }

  .contact-email-link {
    font-size: 16px;
    color: var(--color-textAccent);
    text-decoration: none;
    font-weight: 600;
  }

  .contact-email-link:hover {
    color: var(--color-textAccentHover);
    text-decoration: underline;
  }
</style>