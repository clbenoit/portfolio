---
import { getCollection } from 'astro:content';
import MinimalLayout from '../../../layouts/MinimalLayout.astro';
import BackArrow from '../../../components/BackArrow.astro';

const posts = await getCollection('blog_fr');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<MinimalLayout title="Blog" lang="fr">
  <div class="blog-layout">
    <BackArrow href="/portfolio/fr/" />
    <h1>Blog</h1>
    <div class="blog-list">
    {posts.map(post => (
      <article class="blog-entry">
        <h2 class="blog-entry-title">
          <a href={`/portfolio/fr/blog/${post.id}/`}>{post.data.title}</a>
        </h2>
        <time class="blog-entry-date" datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="blog-entry-tags">
            {post.data.tags.map(tag => (
              <span class="blog-tag">{tag}</span>
            ))}
          </div>
        )}
        {post.data.description && (
          <p class="blog-entry-desc">{post.data.description}</p>
        )}
      </article>
    ))}
  </div>
  </div>
</MinimalLayout>

<style>
  .blog-layout {
    max-width: 760px;
    margin: 0 auto;
    padding: 80px 40px;
  }

  @media (max-width: 767px) {
    .blog-layout {
      padding: 40px 16px;
    }
  }
  .blog-list {
    max-width: 720px;
  }

  .blog-entry {
    padding: 24px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-entry:first-child {
    padding-top: 0;
  }

  .blog-entry-title {
    margin: 0 0 4px;
    font-size: 20px;
  }

  .blog-entry-title a {
    color: var(--color-heading);
    text-decoration: none;
  }

  .blog-entry-title a:hover {
    color: var(--color-textAccent);
  }

  .blog-entry-date {
    font-size: 14px;
    color: var(--color-text3);
  }

  .blog-entry-desc {
    margin-top: 8px;
    color: var(--color-text2);
    font-size: 15px;
  }

  .blog-entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .blog-tag {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    padding: 2px 8px;
    border-radius: 4px;
    background: var(--color-backgroundIrisTint);
    color: var(--color-textAccent);
  }
</style>