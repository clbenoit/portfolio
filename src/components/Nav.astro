---
import { topNav, siteConfig, locales, localizedHref, localeLabels } from '../config';
import type { Locale } from '../config';

export interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
const otherLang = lang === 'fr' ? 'en' : 'fr';
const otherLabel = localeLabels[otherLang];
const currentLabel = localeLabels[lang];
---

<nav class="top-nav" data-open="false">
  <div class="top-nav-inner">
    <a href={`/portfolio/${lang}/`} class="top-nav-title">{siteConfig.title}</a>
    <button class="hamburger" aria-label="Toggle navigation menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
    <div class="top-nav-dropdown">
      <div class="top-nav-links">
        {topNav.map(item => {
          const localizedHrefVal = localizedHref(item.href, lang);
          return (
            <a
              href={localizedHrefVal}
              class={currentPath.startsWith(localizedHrefVal) ? 'top-nav-link active' : 'top-nav-link'}
            >
              {item.text}
            </a>
          );
        })}
        <a
          href={currentPath.replace(`/${lang}/`, `/${otherLang}/`)}
          class="top-nav-link lang-switch"
          data-current={currentLabel}
        >
          {otherLabel}
        </a>
      </div>
    </div>
    <a
      href={currentPath.replace(`/${lang}/`, `/${otherLang}/`)}
      class="lang-switch-desktop"
      aria-label={`Switch to ${otherLabel}`}
    >
      {otherLabel}
    </a>
  </div>
</nav>

<style>
  .top-nav {
    background: var(--color-backgroundDark);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0 40px;
  }

  .top-nav-inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .top-nav-title {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-title);
    text-decoration: none;
  }

  .hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text2);
    padding: 8px;
    border-radius: 6px;
  }

  .hamburger:hover {
    color: var(--color-text);
    background: var(--color-background3);
  }

  .top-nav-dropdown {
    display: flex;
  }

  .top-nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
  }

  .top-nav-link {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text2);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }

  .top-nav-link:hover {
    color: var(--color-text);
    background: var(--color-background3);
  }

  .top-nav-link.active {
    color: var(--color-backgroundAccent);
  }

  .lang-switch {
    border-left: 1px solid var(--color-border);
    margin-left: 8px;
    padding-left: 16px;
    font-weight: 700;
  }

  .lang-switch-desktop {
    display: none;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text2);
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    transition: color 0.15s, background 0.15s, border-color 0.15s;
    margin-left: 8px;
  }

  .lang-switch-desktop:hover {
    color: var(--color-text);
    background: var(--color-background3);
    border-color: var(--color-border2);
  }

  @media (min-width: 768px) {
    .lang-switch-desktop {
      display: inline-flex;
      align-items: center;
    }

    .lang-switch {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .top-nav {
      padding: 0 16px;
    }

    .hamburger {
      display: block;
      order: 2;
    }

    .lang-switch-desktop {
      display: none;
    }

    .top-nav-dropdown {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-backgroundDark);
      border-bottom: 1px solid var(--color-border);
      flex-direction: column;
      padding: 8px 0;
    }

    .top-nav[data-open="true"] .top-nav-dropdown {
      display: flex;
    }

    .top-nav-links {
      flex-direction: column;
      gap: 4px;
      padding: 0 16px;
    }

    .top-nav-link {
      padding: 10px 12px;
      font-size: 16px;
    }

    .lang-switch {
      border-left: none;
      border-top: 1px solid var(--color-border);
      margin-left: 0;
      padding-left: 12px;
      padding-top: 12px;
      margin-top: 8px;
    }
  }
</style>

<script>
  const nav = document.querySelector('.top-nav');
  const hamburger = nav?.querySelector('.hamburger');

  hamburger?.addEventListener('click', () => {
    const isOpen = nav.getAttribute('data-open') === 'true';
    nav.setAttribute('data-open', isOpen ? 'false' : 'true');
  });

  nav?.querySelectorAll('.top-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      nav.setAttribute('data-open', 'false');
    });
  });
</script>

<script>
  document.querySelectorAll('.lang-switch, .lang-switch-desktop').forEach(btn => {
    btn.addEventListener('click', () => {
      var m = window.location.pathname.match(/^\/(?:portfolio\/)?(fr|en)\//);
      var current = m ? m[1] : 'en';
      var next = current === 'fr' ? 'en' : 'fr';
      localStorage.setItem('lang', next);
    });
  });
</script>