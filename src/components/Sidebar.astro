---
import { sidebar, localizedHref } from '../config';
import type { Locale } from '../config';

export interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<aside class="sidebar">
  <a class="sidebar-newsletter" href={localizedHref('/portfolio/newsletter/', lang)}>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
      <path d="m22 7-10 6L2 7"></path>
    </svg>
    Newsletter
  </a>
  {sidebar.map(section => (
    <div class="sidebar-section">
      {section.link ? (
        <a
          href={localizedHref(section.href, lang)}
          class={currentPath === section.href ? 'sidebar-heading-link active' : 'sidebar-heading-link'}
        >
          {section.text}
        </a>
      ) : (
        <span class="sidebar-heading">{section.text}</span>
      )}
      {section.items && (
        <ul class="sidebar-items">
          {section.items.map(item => (
            <li>
              <a
                href={localizedHref(item.href, lang)}
                class={currentPath === item.href ? 'sidebar-link active' : 'sidebar-link'}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  ))}
</aside>

<style>
  .sidebar {
    width: 240px;
    flex-shrink: 0;
    padding: 32px 16px 32px 0;
    border-right: 1px solid var(--color-border);
    position: sticky;
    top: 80px;
    height: calc(100vh - 80px);
    overflow-y: auto;
  }

  .sidebar-section {
    margin-bottom: 24px;
  }

  .sidebar-newsletter {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-backgroundAccent);
    text-decoration: none;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 24px;
    transition: background 0.15s, color 0.15s;
  }

  .sidebar-newsletter:hover {
    background: var(--color-backgroundIrisTint);
    color: var(--color-backgroundAccent);
  }

  .sidebar-newsletter svg {
    flex-shrink: 0;
  }

  .sidebar-heading {
    display: block;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text3);
    padding: 4px 8px 8px;
    margin-top: 8px;
  }

  .sidebar-heading-link {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text2);
    text-decoration: none;
    padding: 6px 8px;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }

  .sidebar-heading-link:hover {
    background: var(--color-background3);
    color: var(--color-text);
  }

  .sidebar-heading-link.active {
    color: var(--color-backgroundAccent);
    background: var(--color-backgroundIrisTint);
  }

  .sidebar-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-link {
    display: block;
    font-size: 13px;
    color: var(--color-text3);
    text-decoration: none;
    padding: 5px 8px 5px 16px;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }

  .sidebar-link:hover {
    background: var(--color-background3);
    color: var(--color-text);
  }

  .sidebar-link.active {
    color: var(--color-backgroundAccent);
    background: var(--color-backgroundIrisTint);
  }

  @media (max-width: 767px) {
    .sidebar {
      display: none;
    }
  }
</style>