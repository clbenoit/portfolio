# Web3Forms access key for the project request form
# Get yours at https://web3forms.com/
# In production, set this as a GitHub Actions secret named WEB3FORMS_KEY
PUBLIC_WEB3FORMS_KEY=your_access_key_here

# Google Apps Script webhook URL for client info storage
# Deploy an Apps Script web app and paste the URL here
# In production, set this as a GitHub Actions variable named APPS_SCRIPT_URL
PUBLIC_APPS_SCRIPT_URL=your_apps_script_url_here